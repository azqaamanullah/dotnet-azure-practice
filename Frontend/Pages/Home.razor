@page "/"
@using Frontend.Models
@using Frontend.Shared

<PageTitle>My Cloud Dev Portfolio</PageTitle>


<h1>Welcome to my Automated DevOps Lab!</h1>
<p>This application serves as a living proof-of-concept for modern cloud architecture and automated software delivery.</p>

<section class="hero">

    <div class="hero-content">

        <p class="hero-greeting">
            Hello, I'm
        </p>

        <h1>
            Azqa Aman Ullah
        </h1>

        <h2>
            Full Stack Software Developer
        </h2>

        <p class="hero-description">
            I build modern, scalable web applications using
            C#, .NET, React, JavaScript and SQL.
        </p>

        <div class="hero-buttons">

            <a href="#projects" class="primary-button">
                View My Work
            </a>

            <a href="#contact" class="secondary-button">
                Contact Me
            </a>

        </div>

        <div class="hero-tech">

            <span>C#</span>
            <span>.NET</span>
            <span>React</span>
            <span>SQL</span>
            <span>Azure</span>

        </div>

    </div>

</section>


<section id="about" class="section">

    <div class="section-container">

        <p class="section-label">
            ABOUT ME
        </p>

        <h2>
            Building software that solves real problems
        </h2>

        <div class="about-content">

            <div>

                <p>
                    I am a Software Engineer with experience developing
                    web applications using C#, .NET, React, Node.js
                    and relational databases.
                </p>

                <p>
                    I enjoy building clean user interfaces, developing
                    REST APIs and working across the full software
                    development lifecycle.
                </p>

                <p>
                    I am particularly interested in .NET, cloud
                    technologies and modern web development.
                </p>

            </div>

            <div class="about-stats">

                <div>
                    <strong>3+</strong>
                    <span>Years Experience</span>
                </div>

                <div>
                    <strong>5+</strong>
                    <span>Projects</span>
                </div>

                <div>
                    <strong>10+</strong>
                    <span>Technologies</span>
                </div>

            </div>

        </div>

    </div>

</section>


<section id="skills" class="section skills-section">

    <div class="section-container">

        <p class="section-label">
            SKILLS
        </p>

        <h2>
            Technologies I work with
        </h2>

        <div class="skills-grid">

            <div class="skill-card">

                <h3>Frontend</h3>

                <p>
                    HTML, CSS, JavaScript, TypeScript,
                    React, Blazor
                </p>

            </div>

            <div class="skill-card">

                <h3>Backend</h3>

                <p>
                    C#, .NET, ASP.NET Core,
                    ASP.NET MVC, Node.js, Express
                </p>

            </div>

            <div class="skill-card">

                <h3>Database</h3>

                <p>
                    SQL Server, MySQL,
                    Oracle, PostgreSQL
                </p>

            </div>

            <div class="skill-card">

                <h3>Cloud & Tools</h3>

                <p>
                    Azure, Azure DevOps,
                    Git, GitHub, CI/CD
                </p>

            </div>

        </div>

    </div>

</section>


<section id="projects" class="section">

    <div class="section-container">

        <p class="section-label">
            PROJECTS
        </p>

        <h2>
            Featured Projects
        </h2>

        <div class="projects-grid">

            <ProjectCard Project="@Interpay" />

            <ProjectCard Project="@Payabhi" />

            <ProjectCard Project="@Attendance" />

            <ProjectCard Project="@DigitRecognition" />

        </div>

    </div>

</section>


<section id="experience" class="section experience-section">

    <div class="section-container">

        <p class="section-label">
            EXPERIENCE
        </p>

        <h2>
            Professional Experience
        </h2>

        <div class="timeline">

            <div class="timeline-item">

                <span class="timeline-date">
                    2022 – 2024
                </span>

                <h3>
                    Software Developer
                </h3>

                <h4>
                    Qenta
                </h4>

                <p>
                    Developed and maintained web applications
                    using C#, .NET, ASP.NET and database technologies.
                    Worked on application features, APIs and
                    database-driven functionality.
                </p>

            </div>

        </div>

    </div>

</section>


<section id="contact" class="section contact-section">

    <div class="section-container contact-container">

        <p class="section-label">
            CONTACT
        </p>

        <h2>
            Let's work together
        </h2>

        <p>
            I'm currently open to software development opportunities
            in the UK.
        </p>

        <div class="contact-buttons">

            <a href="mailto:YOUR_EMAIL@example.com"
               class="primary-button">
                Email Me
            </a>

            <a href="https://github.com/YOUR_USERNAME"
               target="_blank"
               class="secondary-button">
                GitHub
            </a>

            <a href="https://www.linkedin.com/in/YOUR_USERNAME/"
               target="_blank"
               class="secondary-button">
                LinkedIn
            </a>

        </div>

    </div>

</section>


@code {

    private Project Interpay = new()
    {
        Title = "Interpay Africa",
        Description = "A payment-focused web application developed using ASP.NET and Oracle.",
        Technologies = ["ASP.NET", "C#", "Oracle"],
        GitHubUrl = "#"
    };

    private Project Payabhi = new()
    {
        Title = "Payabhi",
        Description = "A full-stack web application with a React frontend and Node.js backend.",
        Technologies = ["React", "Node.js", "MySQL"],
        GitHubUrl = "#"
    };

    private Project Attendance = new()
    {
        Title = "Online Attendance System",
        Description = "A database-driven attendance management application.",
        Technologies = ["ASP.NET MVC", "C#", "SQL Server"],
        GitHubUrl = "#"
    };

    private Project DigitRecognition = new()
    {
        Title = "Handwritten Digit Recognition",
        Description = "An image-processing project for recognizing handwritten digits.",
        Technologies = ["Python", "OpenCV"],
        GitHubUrl = "#"
    };

}